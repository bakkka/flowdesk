# Local development
DATABASE_URL="file:./dev.db"

# Session signing secret (generate a unique one for production)
SESSION_SECRET="replace-with-a-long-random-string"

# Telegram bot (optional: the bot stays offline without a token)
TELEGRAM_BOT_TOKEN=""
# Fallback for admin alerts. The value from the admin panel (Setting.admin_chat_id) wins.
TELEGRAM_ADMIN_CHAT_ID=""

# Public site url — used in metadata, sitemap and links.
# Local: http://localhost:3000 · Production: https://your-domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public link to the bot, shown on the landing page and in admin settings.
# Leave empty to hide the link. Example: https://t.me/your_bot
NEXT_PUBLIC_TELEGRAM_BOT_URL=""

# --- Production with Postgres -------------------------------------------
# 1) prisma/schema.prisma: provider = "postgresql"
# 2) DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# 3) npx prisma db push && npm run db:seed
